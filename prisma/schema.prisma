  conflictResolved Boolean      @default(false)
  isCorrected      Boolean      @default(false)
  profile          UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source           MetricSource @relation(fields: [metricSourceId], references: [id], onDelete: Restrict)

  @@index([profileId, metricType, recordedAt])
}

