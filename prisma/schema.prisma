generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id                       String                    @id @default(uuid())
  userId                   String                    @unique
  email                    String                    @unique
  fullName                 String?
  avatarUrl                String?
  role                     String                    @default("user")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  password                 String?
  auraTokens               Int                       @default(20)
  tokensResetAt            DateTime                  @default(now())
  emailVerified            Boolean                   @default(false)
  conversations            AIConversation[]
  aiDecisionLogs           AIDecisionLog[]
  summaries                AIHealthSummary[]
  aiReasonings             AIReasoning[]
  recommendationsP2        AIRecommendation[]
  aiSchedulePredictions    AISchedulePrediction[]
  aiAnalytics              AIUsageAnalytics[]
  alerts                   Alert[]
  allergyProfiles          AllergyProfile[]
  AuditLog                 AuditLog[]
  auraWorkoutMemory        AuraWorkoutMemory?
  burnoutLogs              BurnoutScoreLog[]
  calorieLogs              CalorieLog[]
  cameraSessions           CameraSession[]
  circadianPreference      CircadianPreference?
  connectedPlatforms       ConnectedFoodPlatform[]
  conversationSummaries    ConversationSummary[]
  dietaryRestrictions      DietaryRestriction[]
  exerciseHistory          ExerciseHistory[]
  foodAnalyses             FoodAnalysis[]
  goals                    Goal[]
  goalPlans                GoalPlan[]
  insights                 HealthInsight[]
  healthMemories           HealthMemory[]
  predictionsP2            HealthPrediction[]
  healthRecords            HealthRecord[]
  injuryPredictions        InjuryPrediction[]
  integrations             Integration[]
  longTermMemories         LongTermMemory[]
  meals                    Meal[]
  mealFeedbacks            MealFeedback[]
  mealPreferences          MealPreference[]
  mealRecommendations      MealRecommendation[]
  mealStreaks              MealStreak[]
  medicalDocuments         MedicalDocument[]
  reports                  MedicalReport[]
  medicalReportAnalyses    MedicalReportAnalysis[]
  medicalResults           MedicalReportResult[]
  medicalTimelines         MedicalTimeline[]
  medications              Medication[]
  medicationLogs           MedicationLog[]
  medicationSchedules      MedicationSchedule[]
  memoryNodes              MemoryNode[]
  muscleRecovery           MuscleRecovery[]
  notifications            Notification[]
  nutritionLogs            Nutrition[]
  nutritionRecommendations NutritionRecommendation[]
  orderHistories           OrderHistory[]
  personalRecords          PersonalRecord[]
  predictions              Prediction[]
  recoveryLogs             RecoveryScoreLog[]
  savedMeals               SavedMeal[]
  savedRestaurants         SavedRestaurant[]
  scheduleEvents           ScheduleEvent[]
  scheduleVersions         ScheduleVersion[]
  searchHistory            SearchHistory[]
  settings                 Settings?
  sleepLogs                SleepLog[]
  symptoms                 Symptom[]
  timeline                 TimelineEvent[]
  toolInvocations          ToolInvocation[]
  achievements             UserAchievement[]
  baselines                UserBaseline[]
  userMemory               UserMemory?
  preferences              UserPreference[]
  voiceAnalytics           VoiceAnalytics[]
  voiceSessions            VoiceSession[]
  voiceSettings            VoiceSettings?
  voiceTranscripts         VoiceTranscript[]
  wakeWordEvents           WakeWordEvents[]
  weatherSnapshots         WeatherSnapshot[]
  workouts                 Workout[]
  workoutSessions          WorkoutSession[]
  deviceConnections        DeviceConnection[]
  providerTokens           ProviderToken[]
  healthMetrics            HealthMetric[]
  deviceAuditLogs          DeviceAuditLog[]
  primaryDevices           PrimaryDevice[]
  deviceHealths            DeviceHealth[]
  metricAggregations       MetricAggregation[]
}

model Settings {
  id               String      @id @default(uuid())
  profileId        String      @unique
  theme            String      @default("dark")
  notifications    Boolean     @default(true)
  language         String      @default("en")
  privacyShareData Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  profile          UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id        String      @id @default(uuid())
  profileId String
  category  String
  value     String
  notes     String?
  createdAt DateTime    @default(now())
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model UserMemory {
  id                String      @id @default(uuid())
  profileId         String      @unique
  dietPreference    String?
  allergies         String[]
  workoutPreference String?
  sleepSchedule     String?
  favoriteFoods     String[]
  units             String      @default("metric")
  fitnessGoals      String[]
  updatedAt         DateTime    @updatedAt
  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model SearchHistory {
  id        String      @id @default(uuid())
  profileId String
  query     String
  category  String
  createdAt DateTime    @default(now())
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model HealthRecord {
  id            String      @id @default(uuid())
  profileId     String
  vitalityScore Int         @default(100)
  heartRate     Int?
  bloodPressure String?
  weight        Float?
  height        Float?
  bloodSugar    Float?
  oxygenLevel   Float?
  recordedAt    DateTime    @default(now())
  hrv           Int?
  provider      String      @default("manual")
  recoveryScore Int?
  stressLevel   Float?
  waterIntakeMl Int         @default(0)
  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model UserBaseline {
  id           String      @id @default(uuid())
  profileId    String
  metricName   String
  value        Float
  windowDays   Int         @default(30)
  calculatedAt DateTime    @default(now())
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Workout {
  id             String      @id @default(uuid())
  profileId      String
  type           String
  duration       Int
  caloriesBurned Int
  intensity      String
  notes          String?
  recordedAt     DateTime    @default(now())
  profile        UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model WorkoutSession {
  id             String        @id @default(uuid())
  profileId      String
  exerciseName   String
  difficulty     String
  equipment      String[]
  durationSec    Int
  caloriesBurned Int
  repCount       Int
  avgAccuracy    Float
  muscleLoad     Json
  safetyFlags    String[]
  jointAngleLogs Json
  recordedAt     DateTime      @default(now())
  repsLogs       RepAnalysis[]
  profile        UserProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sets           WorkoutSet[]
}

model SleepLog {
  id            String      @id @default(uuid())
  profileId     String
  durationHours Float
  deepSleepMin  Int
  remSleepMin   Int
  qualityScore  Int
  recordedAt    DateTime    @default(now())
  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Nutrition {
  id            String      @id @default(uuid())
  profileId     String
  mealType      String
  foodName      String
  calories      Int
  protein       Float
  carbs         Float
  fat           Float
  waterIntakeMl Int         @default(0)
  recordedAt    DateTime    @default(now())
  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Meal {
  id           String      @id @default(uuid())
  profileId    String
  name         String
  type         String
  totalCals    Int
  totalProtein Float
  totalCarbs   Float
  totalFat     Float
  loggedAt     DateTime    @default(now())
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items        MealItem[]
}

model MealItem {
  id     String @id @default(uuid())
  mealId String
  foodId String
  amount Float
  unit   String
  food   Food   @relation(fields: [foodId], references: [id])
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model Food {
  id            String     @id @default(uuid())
  name          String
  aliases       String[]
  category      String
  servingSize   Float
  servingUnit   String
  calories      Int
  protein       Float
  carbs         Float
  fat           Float
  fiber         Float
  sugar         Float
  sodium        Float?
  potassium     Float?
  calcium       Float?
  iron          Float?
  vitaminC      Float?
  vitaminD      Float?
  isVegetarian  Boolean    @default(false)
  isVegan       Boolean    @default(false)
  isGlutenFree  Boolean    @default(false)
  benefits      String[]
  risks         String[]
  createdAt     DateTime   @default(now())
  magnesium     Float?
  vitaminA      Float?
  vitaminB12    Float?
  glycemicIndex Float?
  glycemicLoad  Float?
  apiSource     String?
  confidence    Float?
  cachedAt      DateTime?
  mealItems     MealItem[]
}

model AIConversation {
  id        String      @id @default(uuid())
  profileId String
  agentType String
  title     String      @default("New Conversation")
  createdAt DateTime    @default(now())
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
}

model AIMessage {
  id               String         @id @default(uuid())
  conversationId   String
  content          String
  createdAt        DateTime       @default(now())
  contextUsed      Json?
  intent           String?
  latencyMs        Int?
  role             String
  toolsUsed        String[]
  model            String?
  provider         String?
  cachedTokens     Int?
  completionTokens Int?
  cost             Float?
  promptTokens     Int?
  conversation     AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model VectorDocument {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  metadata  Json?
  embedding Json?
  createdAt DateTime @default(now())
}

model Prediction {
  id             String      @id @default(uuid())
  profileId      String
  metric         String
  predictedValue Float
  confidence     Int
  timeframeHours Int
  reasoning      String
  generatedAt    DateTime    @default(now())
  profile        UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Alert {
  id           String      @id @default(uuid())
  profileId    String
  title        String
  message      String
  severity     String
  metricSource String
  isRead       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id          String      @id @default(uuid())
  profileId   String
  type        String
  title       String
  description String
  timestamp   DateTime    @default(now())
  metadata    Json?
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Medication {
  id        String      @id @default(uuid())
  profileId String
  name      String
  dosage    String
  frequency String
  active    Boolean     @default(true)
  startDate DateTime    @default(now())
  endDate   DateTime?
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Symptom {
  id         String      @id @default(uuid())
  profileId  String
  name       String
  severity   Int
  notes      String?
  recordedAt DateTime    @default(now())
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model MedicalReport {
  id             String      @id @default(uuid())
  profileId      String
  fileName       String
  fileUrl        String
  summary        String?
  structuredData Json?
  analyzedAt     DateTime?
  createdAt      DateTime    @default(now())
  profile        UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Goal {
  id           String      @id @default(uuid())
  profileId    String
  category     String
  title        String
  targetValue  Float
  currentValue Float       @default(0)
  unit         String
  deadline     DateTime?
  completed    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model UserAchievement {
  id          String      @id @default(uuid())
  profileId   String
  title       String
  description String
  unlockedAt  DateTime    @default(now())
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String      @id @default(uuid())
  profileId String
  title     String
  message   String
  read      Boolean     @default(false)
  type      String      @default("info")
  createdAt DateTime    @default(now())
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Integration {
  id           String      @id @default(uuid())
  profileId    String
  provider     String
  accessToken  String
  refreshToken String?
  connected    Boolean     @default(true)
  lastSyncedAt DateTime    @default(now())
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProviderSyncLog {
  id        String   @id @default(uuid())
  profileId String
  provider  String
  status    String
  error     String?
  syncedAt  DateTime @default(now())
}

model VerificationOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model HealthInsight {
  id               String          @id @default(uuid())
  profileId        String
  category         InsightCategory
  summary          Json
  confidence       Float
  detectedAt       DateTime        @default(now())
  modelVersion     String?
  provider         String?
  promptVersion    String?
  processingTimeMs Int?
  tokensUsed       Int?
  profile          UserProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([detectedAt])
  @@index([category])
}

model RecoveryScoreLog {
  id                    String      @id @default(uuid())
  profileId             String
  score                 Int
  sleepContribution     Int
  nutritionContribution Int
  stressContribution    Int
  hydrationContribution Int
  exerciseContribution  Int
  breakdown             Json
  reasons               String[]
  recommendations       String[]
  confidence            Float
  recordedAt            DateTime    @default(now())
  modelVersion          String?
  provider              String?
  promptVersion         String?
  processingTimeMs      Int?
  tokensUsed            Int?
  profile               UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([recordedAt])
}

model BurnoutScoreLog {
  id               String      @id @default(uuid())
  profileId        String
  score            Int
  riskLevel        RiskLevel
  reasons          String[]
  recommendations  String[]
  confidence       Float
  recordedAt       DateTime    @default(now())
  modelVersion     String?
  provider         String?
  promptVersion    String?
  processingTimeMs Int?
  tokensUsed       Int?
  profile          UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([recordedAt])
}

model FoodAnalysis {
  id               String           @id @default(uuid())
  profileId        String
  imageUrl         String
  mealType         String
  mealTime         DateTime         @default(now())
  foodItems        String[]
  ingredients      Json
  calories         Int
  protein          Float
  fat              Float
  carbs            Float
  fiber            Float
  sugar            Float
  vitamins         Json
  minerals         Json
  glycemicLoad     Float?
  portionSize      String
  confidenceScore  Float
  healthRating     Int
  alternatives     String[]
  explanation      String
  status           ProcessingStatus @default(PENDING)
  analyzedAt       DateTime         @default(now())
  modelVersion     String?
  provider         String?
  promptVersion    String?
  processingTimeMs Int?
  tokensUsed       Int?
  imageHash        String?
  nutritionSource  String?
  profile          UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([analyzedAt])
  @@index([status])
}

model MedicalReportResult {
  id               String           @id @default(uuid())
  profileId        String
  reportId         String           @unique
  originalFileUrl  String?
  ocrText          String?
  reportType       String?
  labName          String?
  reportDate       DateTime?
  doctorName       String?
  summary          Json
  abnormalValues   Json
  terminology      Json
  doctorQuestions  String[]
  comparedToId     String?
  confidence       Float
  status           ProcessingStatus @default(PENDING)
  analyzedAt       DateTime         @default(now())
  modelVersion     String?
  provider         String?
  promptVersion    String?
  processingTimeMs Int?
  tokensUsed       Int?
  profile          UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([status])
}

model AIHealthSummary {
  id               String           @id @default(uuid())
  profileId        String
  type             SummaryType
  priority         String           @default("normal")
  read             Boolean          @default(false)
  expiresAt        DateTime?
  content          Json
  confidence       Float
  status           ProcessingStatus @default(PENDING)
  generatedAt      DateTime         @default(now())
  modelVersion     String?
  provider         String?
  promptVersion    String?
  processingTimeMs Int?
  tokensUsed       Int?
  profile          UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([generatedAt])
  @@index([status])
}

model HealthPrediction {
  id             String           @id @default(uuid())
  profileId      String
  metric         PredictionMetric
  predictedValue Float
  confidence     Float
  timeframeHours Int
  reasoning      String
  generatedAt    DateTime         @default(now())
  profile        UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([generatedAt])
}

model AIRecommendation {
  id          String                 @id @default(uuid())
  profileId   String
  text        String
  severity    RecommendationSeverity
  category    String
  sources     Json
  confidence  Float
  generatedAt DateTime               @default(now())
  profile     UserProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([generatedAt])
}

model MemoryNode {
  id         String      @id @default(uuid())
  profileId  String
  label      String
  category   String
  confidence Float
  createdAt  DateTime    @default(now())
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model AIAuditLog {
  id         String   @id @default(uuid())
  profileId  String
  action     String
  prompt     String
  model      String
  response   String
  latencyMs  Int
  tokensUsed Int?
  timestamp  DateTime @default(now())
}

model AIModel {
  id                String  @id @default(uuid())
  name              String  @unique
  displayName       String
  provider          String
  supportsVision    Boolean @default(false)
  supportsReasoning Boolean @default(false)
  supportsStreaming Boolean @default(true)
  maxTokens         Int     @default(8192)
  temperature       Float   @default(0.7)
  enabled           Boolean @default(true)
  priority          Int     @default(1)
  description       String?
}

model AIAgent {
  id           String   @id @default(uuid())
  name         String   @unique
  displayName  String
  systemPrompt String
  modelId      String
  createdAt    DateTime @default(now())
}

model AITool {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  endpoint    String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AIToolCall {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String?
  toolName       String
  arguments      Json
  latencyMs      Int?
  createdAt      DateTime @default(now())
}

model AIToolResult {
  id         String   @id @default(uuid())
  toolCallId String   @unique
  result     Json
  createdAt  DateTime @default(now())
}

model LongTermMemory {
  id         String      @id @default(uuid())
  profileId  String
  fact       String
  confidence Float       @default(1.0)
  source     String?
  createdAt  DateTime    @default(now())
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ShortTermMemory {
  id        String   @id @default(uuid())
  profileId String
  context   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ConversationMemory {
  id             String   @id @default(uuid())
  conversationId String
  summary        String
  updatedAt      DateTime @updatedAt
}

model HealthMemory {
  id         String      @id @default(uuid())
  profileId  String
  category   String
  value      String
  confidence Float
  createdAt  DateTime    @default(now())
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model AIConversationSettings {
  id             String  @id @default(uuid())
  conversationId String  @unique
  autoImages     Boolean @default(true)
  autoDiagrams   Boolean @default(true)
  memoryEnabled  Boolean @default(true)
}

model AIAttachment {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String?
  fileUrl        String
  fileType       String
  metadata       Json?
  createdAt      DateTime @default(now())
}

model AIUsageAnalytics {
  id                    String      @id @default(uuid())
  profileId             String
  periodStart           DateTime
  periodEnd             DateTime
  totalPromptTokens     Int         @default(0)
  totalCompletionTokens Int         @default(0)
  totalCost             Float       @default(0.0)
  updatedAt             DateTime    @updatedAt
  profile               UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model MedicalDocument {
  id               String                 @id @default(uuid())
  userId           String
  title            String
  category         String
  fileUrl          String
  storagePath      String
  fileSize         String
  mimeType         String
  uploadedAt       DateTime               @default(now())
  reportDate       DateTime?
  hospital         String?
  doctor           String?
  status           String                 @default("pending")
  summary          String?
  processingStatus String                 @default("PENDING")
  aiAnalyzed       Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             UserProfile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis         MedicalReportAnalysis?
  timelineEvents   MedicalTimeline[]

  @@index([userId])
}

model MedicalReportAnalysis {
  id                 String          @id @default(uuid())
  documentId         String          @unique
  userId             String
  overallHealthScore Int             @default(0)
  summary            String
  riskLevel          String          @default("LOW")
  abnormalValues     Json
  normalValues       Json
  recommendations    Json
  doctorQuestions    Json
  followUpActions    Json
  dietPlan           Json
  exercisePlan       Json
  supplements        Json
  hydrationAdvice    Json
  sleepAdvice        Json
  confidence         Float           @default(1.0)
  generatedAt        DateTime        @default(now())
  document           MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user               UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MedicalTimeline {
  id          String          @id @default(uuid())
  userId      String
  documentId  String
  eventDate   DateTime        @default(now())
  title       String
  description String
  metadata    Json?
  createdAt   DateTime        @default(now())
  document    MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventDate])
}

model VoiceSession {
  id          String                @id @default(uuid())
  profileId   String
  status      String                @default("ACTIVE")
  startedAt   DateTime              @default(now())
  endedAt     DateTime?
  reasoning   AIReasoning[]
  summaries   ConversationSummary[]
  tools       ToolInvocation[]
  analytics   VoiceAnalytics[]
  profile     UserProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transcripts VoiceTranscript[]

  @@index([profileId])
}

model VoiceTranscript {
  id        String       @id @default(uuid())
  sessionId String
  profileId String
  queryText String
  replyText String
  audioUrl  String?
  timestamp DateTime     @default(now())
  profile   UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  session   VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([profileId])
}

model VoiceAnalytics {
  id               String       @id @default(uuid())
  sessionId        String
  profileId        String
  modelName        String
  providerName     String
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  latencyMs        Int          @default(0)
  sttLatencyMs     Int          @default(0)
  ttsLatencyMs     Int          @default(0)
  cacheHit         Boolean      @default(false)
  errorRate        Float        @default(0.0)
  timestamp        DateTime     @default(now())
  profile          UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
