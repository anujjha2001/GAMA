  id                 String           @id @default(uuid())
  deviceConnectionId String
  metricType         String
  isSupported        Boolean          @default(true)
  deviceConnection   DeviceConnection @relation(fields: [deviceConnectionId], references: [id], onDelete: Cascade)
}

model DevicePermission {
  id                 String           @id @default(uuid())
  deviceConnectionId String
  scope              String
  status             String           @default("REQUESTED") // GRANTED, DENIED, REQUESTED
  updatedAt          DateTime         @updatedAt
  deviceConnection   DeviceConnection @relation(fields: [deviceConnectionId], references: [id], onDelete: Cascade)
}

model ProviderToken {
  id           String      @id @default(uuid())
